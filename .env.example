# Vorlage für die Umgebung. Kopie als .env anlegen und Platzhalter ersetzen.
# Die .env gehört nie ins Repository. Am eigenen Rechner reichen die Standardwerte
# aus hof/settings/dev.py; eine .env braucht es dort nicht.

# Welche Einstellungen gelten: hof.settings.dev, hof.settings.test oder hof.settings.prod
DJANGO_SETTINGS_MODULE=hof.settings.prod

# Langer Zufallswert, z. B. aus: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=<geheimer-schluessel>
DJANGO_DEBUG=false

# Kommagetrennt, z. B. der Tailscale-Name des Servers
DJANGO_ALLOWED_HOSTS=<servername>
DJANGO_CSRF_TRUSTED_ORIGINS=https://<servername>

# postgres://BENUTZER:PASSWORT@HOST:PORT/DATENBANK
DATABASE_URL=postgres://<benutzer>:<passwort>@<host>:5432/<datenbank>

# smtp+tls://BENUTZER:PASSWORT@HOST:587 (lokal: smtp://localhost:1025 für Mailpit)
EMAIL_URL=smtp+tls://<benutzer>:<passwort>@<smtp-host>:587
DJANGO_DEFAULT_FROM_EMAIL=<absender@example.org>

# Nur prod: HTTPS-Weiterleitung und HSTS-Dauer in Sekunden
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_SECURE_HSTS_SECONDS=0
